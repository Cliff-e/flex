# ============================================================================
# Deriv Edge API — production environment (AWS EC2)
# Copy to `.env` on the EC2 instance and fill in the real values.
# NEVER commit the real `.env` file — it contains secrets.
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=production
PORT=5000
# Set to 1 only when behind a load balancer / reverse proxy that strips
# X-Forwarded-* headers at the edge. On plain EC2 leave unset.
TRUST_PROXY=

# --- CORS ------------------------------------------------------------------
# Comma-separated allowlist of origins allowed to call this API.
# `https://flex-api-server.vercel.app` is the existing Vercel frontend.
ALLOWED_ORIGINS=https://flex-api-server.vercel.app

# --- OAuth (Deriv) ---------------------------------------------------------
# Deriv app ID (register at https://deriv.com/oauth2/applications)
VITE_DERIV_APP_ID=
# Secret used to HMAC-sign OAuth state and one-time auth codes.
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# This backend's own public URL (used as OAuth redirect_uri).
# Must be an absolute URL pointing to THIS server, e.g.:
#   http://<EC2-PUBLIC-IP>:5000
API_BASE_URL=
# The existing Vercel frontend URL — Deriv success/error redirects land here.
FRONTEND_URL=https://flex-api-server.vercel.app

# --- Database (optional — not required for the auth/health endpoints) ------
# Only needed if a route uses @workspace/db. The server starts fine without it.
# DATABASE_URL=