{
    "framework": null,
    "installCommand": "npm install -g pnpm@10 && cd ../.. && pnpm install --frozen-lockfile",
    "buildCommand": "./node_modules/.bin/rsbuild build",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://YOUR-DO-APP.ondigitalocean.app/api/:path*"
        },
        { "source": "/(.*)", "destination": "/index.html" }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "Cross-Origin-Opener-Policy", "value": "unsafe-none" },
                { "key": "Cross-Origin-Embedder-Policy", "value": "unsafe-none" }
            ]
        },
        {
            "source": "/static/:path*",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        },
        {
            "source": "/index.html",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
            ]
        },
        {
            "source": "/sw.js",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
            ]
        }
    ]
}
